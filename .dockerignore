# Files Docker should NOT send to the build. Smaller context = faster builds,
# and secrets / junk never end up in an image layer.
.git
.github
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
tests
scripts
docs
.gitattributes
requirements-dev.txt
*.md
Dockerfile
docker-compose.yml
.dockerignore
.env
.env.*
*.pem
*.key
*.zip
